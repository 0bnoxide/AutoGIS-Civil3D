<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AutoGIS.Civil3D.Diagnostics</AssemblyName>
    <RootNamespace>AutoGIS.Civil3D.Diagnostics</RootNamespace>
    <Version>0.1.2</Version>
    <AssemblyVersion>0.1.2.0</AssemblyVersion>
    <FileVersion>0.1.2.0</FileVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AcCoreMgdPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AcDbMgdPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>$(AcMgdPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AecBaseMgd">
      <HintPath>$(AecBaseMgdPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AeccDbMgd">
      <HintPath>$(AeccDbMgdPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateAutodeskReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(AcCoreMgdPath)')" Text="AcCoreMgd.dll was not found. Build with scripts/Build-Diagnostics.ps1 on the Civil 3D 2025 workstation." />
    <Error Condition="!Exists('$(AcDbMgdPath)')" Text="AcDbMgd.dll was not found. Build with scripts/Build-Diagnostics.ps1 on the Civil 3D 2025 workstation." />
    <Error Condition="!Exists('$(AcMgdPath)')" Text="AcMgd.dll was not found. Build with scripts/Build-Diagnostics.ps1 on the Civil 3D 2025 workstation." />
    <Error Condition="!Exists('$(AecBaseMgdPath)')" Text="AecBaseMgd.dll was not found. Build with scripts/Build-Diagnostics.ps1 on the Civil 3D 2025 workstation." />
    <Error Condition="!Exists('$(AeccDbMgdPath)')" Text="AeccDbMgd.dll was not found. Build with scripts/Build-Diagnostics.ps1 on the Civil 3D 2025 workstation." />
  </Target>
</Project>
