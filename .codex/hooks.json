{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/tools/agent-hooks/session-start.sh\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$r = git rev-parse --show-toplevel 2>$null; if ($r) { & (Join-Path $r 'tools/agent-hooks/session-start.ps1') }\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/tools/agent-coordination/coordination.py\" hook pre-tool-use",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$r = git rev-parse --show-toplevel 2>$null; if ($r) { python (Join-Path $r 'tools/agent-coordination/coordination.py') hook pre-tool-use }\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/tools/agent-hooks/post_tool_use.py\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$r = git rev-parse --show-toplevel 2>$null; if ($r) { python (Join-Path $r 'tools/agent-hooks/post_tool_use.py') }\""
          }
        ]
      }
    ]
  }
}
