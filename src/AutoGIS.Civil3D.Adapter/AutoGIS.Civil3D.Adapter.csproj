<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <!-- Autodesk's managed API signatures also reference WindowsBase 8. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <AssemblyMetadata Include="Civil3DSeries" Value="2026" />
    <ProjectReference Include="../AutoGIS.Civil3D.Proposal/AutoGIS.Civil3D.Proposal.csproj" />
    <InternalsVisibleTo Include="AutoGIS.Civil3D.Adapter.Tests" />
  </ItemGroup>
  <PropertyGroup>
    <Civil3DInstallRoot Condition="'$(Civil3DInstallRoot)' == ''">C:\Program Files\Autodesk\AutoCAD 2026</Civil3DInstallRoot>
    <AcMgdPath Condition="'$(AcMgdPath)' == ''">$(Civil3DInstallRoot)\AcMgd.dll</AcMgdPath>
    <AcCoreMgdPath Condition="'$(AcCoreMgdPath)' == ''">$(Civil3DInstallRoot)\AcCoreMgd.dll</AcCoreMgdPath>
    <AcDbMgdPath Condition="'$(AcDbMgdPath)' == ''">$(Civil3DInstallRoot)\AcDbMgd.dll</AcDbMgdPath>
    <AecBaseMgdPath Condition="'$(AecBaseMgdPath)' == ''">$(Civil3DInstallRoot)\ACA\AecBaseMgd.dll</AecBaseMgdPath>
    <AeccDbMgdPath Condition="'$(AeccDbMgdPath)' == ''">$(Civil3DInstallRoot)\C3D\AeccDbMgd.dll</AeccDbMgdPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AcMgd" HintPath="$(AcMgdPath)" Private="false" />
    <Reference Include="AcCoreMgd" HintPath="$(AcCoreMgdPath)" Private="false" />
    <Reference Include="AcDbMgd" HintPath="$(AcDbMgdPath)" Private="false" />
    <Reference Include="AecBaseMgd" HintPath="$(AecBaseMgdPath)" Private="false" />
    <Reference Include="AeccDbMgd" HintPath="$(AeccDbMgdPath)" Private="false" />
  </ItemGroup>
  <Target Name="ValidateAutodeskReferences" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <AutodeskReference Include="$(AcMgdPath);$(AcCoreMgdPath);$(AcDbMgdPath);$(AecBaseMgdPath);$(AeccDbMgdPath)" />
    </ItemGroup>
    <Error Condition="!Exists('%(AutodeskReference.Identity)')" Text="Missing Autodesk reference: %(AutodeskReference.Identity). Install Civil 3D 2026 or set Civil3DInstallRoot or the individual assembly path property." />
    <GetAssemblyIdentity AssemblyFiles="@(AutodeskReference)">
      <Output TaskParameter="Assemblies" ItemName="AutodeskIdentity" />
    </GetAssemblyIdentity>
    <Error Condition="('%(AutodeskIdentity.Name)' == 'AcMgd' Or '%(AutodeskIdentity.Name)' == 'AcCoreMgd' Or '%(AutodeskIdentity.Name)' == 'AcDbMgd') And !$([System.String]::Copy('%(AutodeskIdentity.Version)').StartsWith('25.1.'))" Text="%(AutodeskIdentity.Name) is %(AutodeskIdentity.Version); expected Civil 3D 2026 series 25.1. Refusing a cross-version build." />
    <Error Condition="'%(AutodeskIdentity.Name)' == 'AecBaseMgd' And !$([System.String]::Copy('%(AutodeskIdentity.Version)').StartsWith('8.8.'))" Text="AecBaseMgd is %(AutodeskIdentity.Version); expected Civil 3D 2026 series 8.8. Refusing a cross-version build." />
    <Error Condition="'%(AutodeskIdentity.Name)' == 'AeccDbMgd' And !$([System.String]::Copy('%(AutodeskIdentity.Version)').StartsWith('13.8.'))" Text="AeccDbMgd is %(AutodeskIdentity.Version); expected Civil 3D 2026 series 13.8. Refusing a cross-version build." />
  </Target>
</Project>
