<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <Civil3DYear Condition="'$(Civil3DYear)' == ''">2026</Civil3DYear>
  </PropertyGroup>
  <ItemGroup>
    <!-- Autodesk's managed API signatures also reference WindowsBase 8. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <AssemblyMetadata Include="Civil3DYear" Value="$(Civil3DYear)" />
    <PackageReference Include="AutoCAD.NET" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Core" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Model" PrivateAssets="all" ExcludeAssets="runtime" />
    <ProjectReference Include="../AutoGIS.Civil3D.Proposal/AutoGIS.Civil3D.Proposal.csproj" />
    <InternalsVisibleTo Include="AutoGIS.Civil3D.Adapter.Tests" />
  </ItemGroup>
  <Target Name="ValidateCivil3DYear" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Civil3DYear)' != '2026'" Text="Civil3DYear '$(Civil3DYear)' is not configured. Only Civil 3D 2026 is supported." />
  </Target>
  <Target Name="ValidateAutodeskReferences" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <AcMgdReference Include="@(ReferencePath)" Condition="'%(Filename)' == 'AcMgd'" />
      <AcCoreMgdReference Include="@(ReferencePath)" Condition="'%(Filename)' == 'AcCoreMgd'" />
      <AcDbMgdReference Include="@(ReferencePath)" Condition="'%(Filename)' == 'AcDbMgd'" />
      <AutodeskReference Include="@(AcMgdReference);@(AcCoreMgdReference);@(AcDbMgdReference)" />
    </ItemGroup>
    <Error Condition="'@(AcMgdReference)' == ''" Text="Missing Autodesk reference: AcMgd.dll from AutoCAD.NET 25.1.0." />
    <Error Condition="'@(AcCoreMgdReference)' == ''" Text="Missing Autodesk reference: AcCoreMgd.dll from AutoCAD.NET.Core 25.1.0." />
    <Error Condition="'@(AcDbMgdReference)' == ''" Text="Missing Autodesk reference: AcDbMgd.dll from AutoCAD.NET.Model 25.1.0." />
    <GetAssemblyIdentity AssemblyFiles="@(AutodeskReference)">
      <Output TaskParameter="Assemblies" ItemName="AutodeskIdentity" />
    </GetAssemblyIdentity>
    <Error Condition="!$([System.String]::Copy('%(AutodeskIdentity.Version)').StartsWith('25.1.'))" Text="%(AutodeskIdentity.Name) is %(AutodeskIdentity.Version); expected AutoCAD 2026 series 25.1. Refusing a cross-version build." />
  </Target>
</Project>
